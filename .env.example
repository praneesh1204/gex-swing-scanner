# Copy to .env (git-ignored) and fill in. Never commit real keys.
FLASHALPHA_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
# Optional: Claude summary of each ticker's headlines (headlines are fetched keyless from Google News RSS)
ANTHROPIC_API_KEY=
# Optional: Bigdata.com enrichment (not on the critical path)
BIGDATA_API_KEY=
# IBKR Client Portal Gateway, read-only market data / positions (runs locally, no key; you log in via browser)
IBKR_CP_BASE_URL=https://localhost:5000/v1/api
