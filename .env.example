# Copy to .env (git-ignored) and fill in only what you use. Never commit real keys.
# Everything is optional: with no keys gexscan runs on CBOE delayed chains, yfinance, FRED CSVs and
# Google News RSS. `gexscan capabilities` shows which keys are present (never their values).

# ---- data providers ---------------------------------------------------------------------------
FLASHALPHA_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
# SEC EDGAR (listed, not integrated yet) asks for a contact string, e.g. "your-name your-email@example.com"
SEC_USER_AGENT=
# Paid, optional: real trade-side flow replaces the free volume/OI proxy when present
UNUSUAL_WHALES_API_KEY=
# Listed in the capability report, not integrated yet
TRADIER_TOKEN=
MARKETDATA_TOKEN=
MARKETAUX_API_KEY=
TIINGO_API_KEY=
# Optional: Claude summary of each ticker's headlines
ANTHROPIC_API_KEY=
# Optional: Bigdata.com enrichment (not on the critical path)
BIGDATA_API_KEY=

# ---- broker (READ-ONLY) -----------------------------------------------------------------------
# IBKR Client Portal Gateway: positions + market data via GET on an allow-list. No order endpoints exist
# in gexscan. Runs locally, no key; you log in via the browser.
IBKR_CP_BASE_URL=https://localhost:5000/v1/api

# ---- alert sinks (gexscan alerts --sink ...) ----------------------------------------------------
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
